rs/enginsoysal/following{/other_user}","gists_url":"https://api.github.com/users/enginsoysal/gists{/gist_id}","starred_url":"https://api.github.com/users/enginsoysal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/enginsoysal/subscriptions","organizations_url":"https://api.github.com/users/enginsoysal/orgs","repos_url":"https://api.github.com/users/enginsoysal/repos","events_url":"https://api.github.com/users/enginsoysal/events{/privacy}","received_events_url":"https://api.github.com/users/enginsoysal/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1856,"digest":"sha256:338c008b383a7bff847dee2ec4bdba1c2e5b569924a7f8b88232cf9aa80087ff","download_count":0,"created_at":"2026-11-17T06:08:56Z","updated_at":"2026-11-17T06:08:56Z","browser_download_url":"https://github.com/enginsoysal/engacer-os/releases/download/m1213-v0.12.13/M12STAGE13-SHA256SUMS.txt"},{"url":"https://api.github.com/repos/enginsoysal/engacer-os/releases/assets/757865138","id":757865138,"node_id":"RA_kwDOVj6ISs4tLBqy","name":"m12stage13-starter-manifest.json","label":"","uploader":{"login":"enginsoysal","id":103884748,"node_id":"U_kgDOBjEnzA","avatar_url":"https://avatars.githubusercontent.com/u/103884748?v=4","gravatar_id":"","url":"https://api.github.com/users/enginsoysal","html_url":"https://github.com/enginsoysal","followers_url":"https://api.github.com/users/enginsoysal/followers","following_url":"https://api.github.com/users/enginsoysal/following{/other_user}","gists_url":"https://api.github.com/users/enginsoysal/gists{/gist_id}","starred_url":"https://api.github.com/users/enginsoysal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/enginsoysal/subscriptions","organizations_url":"https://api.github.com/users/enginsoysal/orgs","repos_url":"https://api.github.com/users/enginsoysal/repos","events_url":"https://api.github.com/users/enginsoysal/events{/privacy}","received_events_url":"https://api.github.com/users/enginsoysal/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":656,"digest":"sha256:20dee44438a3ebb99ba5d25341dc1bc2b7a00e79f6ee0c7661813250470132a4","download_count":0,"created_at":"2026-11-17T06:08:56Z","updated_at":"2026-11-17T06:08:57Z","browser_download_url":"https://github.com/enginsoysal/engacer-os/releases/download/m1213-v0.12.13/m12stage13-starter-manifest.json"}],"tarball_url":"https://api.github.com/repos/enginsoysal/engacer-os/tarball/m1213-v0.12.13","zipball_url":"https://api.github.com/repos/enginsoysal/engacer-os/zipball/m1213-v0.12.13","body":"# Engacer OS M12.13 / 0.12.13 - Settings and personalization\n\nM12-STAGE13-VM-v1 native qualification passes for these exact bytes. Complete public publication proof closes separately before the next stage.\n\nBuild: `119eb7a0e54f4914b768c6d31cf3d01c`.\nISO SHA256: `47034f41b0880984018aa67d46265d3af069b7c57120625273ec461fef811efb`.\nVMware ZIP SHA256: `539b0418881070d2e74071870f8f82b34268ff76850fefe84ecd35ee3dfbab29`.\n\n## What changes\n\nSettings offers Appearance, Display, Input and System with shared selected\ncontrols and readable feedback. Colors, wallpaper, pattern and display size\nhave a real preview. Apply and save persists it; Cancel, Escape or closing its\nowner restores the previous session appearance without writing settings.\nAnother Settings window cannot overwrite the preview. Distribution defaults\nare previewed before explicit Apply and do not reinstall removed apps or change\nfiles, pins or independent input preferences.\n\nInput offers explicit 200/500/900-ms intervals and US QWERTY/Dvorak choices,\nclearly saved when clicked. System opens the real Devices, Applications,\nStart/taskbar and Quick settings. Devices Back remembers the System category.\nMalformed saved appearance falls back safely and explains how Apply repairs it.\n\n## How and why\n\nOne generation-scoped owner stores five original visual values, eight category\nbytes and a validation flag. No new preference ABI, application slot, worker,\npixel snapshot or idle scanner is needed. Fixed shell state grows by 32 bytes\nto 553,228. [Architecture](https://github.com/enginsoysal/engacer-os/blob/003b062cef0998fc037d0f9147342c5dac3ef028/docs/architecture/settings-m1213.md),\n[Settings guide](https://github.com/enginsoysal/engacer-os/blob/003b062cef0998fc037d0f9147342c5dac3ef028/docs/handbook/settings-m1213.md) and\n[eight-step installation](https://github.com/enginsoysal/engacer-os/blob/003b062cef0998fc037d0f9147342c5dac3ef028/docs/handbook/install-m1213.md).\n\n## Verification\n\n[Exact-source acceptance](https://github.com/enginsoysal/engacer-os/blob/003b062cef0998fc037d0f9147342c5dac3ef028/evidence/M12/13/acceptance-results.json) binds\n595 compiled inputs and 9 native task/profile checks to real install,\ndisk-identical Cancel/close, Apply bytes, competing previews, protected unsaved\nwork, independent optional-app removal, input persistence and ordinary USB/PS2\nstartup. A semantically malformed record has independently valid filesystem\nCRCs: the real loader refuses it, Settings repairs it and ordinary startup\nloads the exact valid replacement while preserving personal content.\n\nFour actual display profiles include compact light/dark and physical 4K/200%.\nThe real 150% preview cannot close/change scale across another file-dialog owner.\nExact enabled-device VMware, separate BIOS, twelve movement comparisons and\ncompressed boot repair pass. The production decoder passes 562 round-trip pages\nand 10,808 malformed/fuzz cases with unchanged guards and no heap allocation;\nproduction taskbar arithmetic passes 295,907 host assertions.\n\n[Resources](https://github.com/enginsoysal/engacer-os/blob/003b062cef0998fc037d0f9147342c5dac3ef028/evidence/M12/13/resources.json) separate fixed, peak and\ncompleted retention; configured guest RAM is not measured OS consumption.\n\n## Scope and retained limits\n\n- Visual preferences use explicit preview Apply/Cancel. Input choices save\n  independently when clicked. Existing on-disk preference formats remain.\n- Display changes reflow windows for reachability; independent window\n  arrangements are not rolled back. Existing explicit-size limits remain for M12.16.\n- Active file operations/dialogs and Windows jobs guard preference writes.\n  M12.14 retains broader feedback and background transfer/modal arbitration.\n- M12.16 retains cursor/scale work; M12.17 renderer work; M12.18 the earlier\n  BIOS/AHCI observation, complete final controller/original-app matrix and\n  the separate website custom-domain email-sharing observation.\n- Physical/ARM, vendor GPU 3D and universal Windows compatibility remain unqualified.\n- Agent visual review is not a human study. Public release and full website\n  verification close separately before M12.14.\n\n![Actual native Settings](https://raw.githubusercontent.com/enginsoysal/engacer-os/003b062cef0998fc037d0f9147342c5dac3ef028/evidence/M12/13/feature.png)\n"}