/enginsoysal/following{/other_user}","gists_url":"https://api.github.com/users/enginsoysal/gists{/gist_id}","starred_url":"https://api.github.com/users/enginsoysal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/enginsoysal/subscriptions","organizations_url":"https://api.github.com/users/enginsoysal/orgs","repos_url":"https://api.github.com/users/enginsoysal/repos","events_url":"https://api.github.com/users/enginsoysal/events{/privacy}","received_events_url":"https://api.github.com/users/enginsoysal/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1856,"digest":"sha256:398a4955aa7721c40127f1c6832b25c78232b7cd588d7eb7f273d062792ac18d","download_count":0,"created_at":"2026-11-17T10:27:10Z","updated_at":"2026-11-17T10:27:10Z","browser_download_url":"https://github.com/enginsoysal/engacer-os/releases/download/m1216-v0.12.16/M12STAGE16-SHA256SUMS.txt"},{"url":"https://api.github.com/repos/enginsoysal/engacer-os/releases/assets/758601531","id":758601531,"node_id":"RA_kwDOVj6ISs4tN1c7","name":"m12stage16-starter-manifest.json","label":"","uploader":{"login":"enginsoysal","id":103884748,"node_id":"U_kgDOBjEnzA","avatar_url":"https://avatars.githubusercontent.com/u/103884748?v=4","gravatar_id":"","url":"https://api.github.com/users/enginsoysal","html_url":"https://github.com/enginsoysal","followers_url":"https://api.github.com/users/enginsoysal/followers","following_url":"https://api.github.com/users/enginsoysal/following{/other_user}","gists_url":"https://api.github.com/users/enginsoysal/gists{/gist_id}","starred_url":"https://api.github.com/users/enginsoysal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/enginsoysal/subscriptions","organizations_url":"https://api.github.com/users/enginsoysal/orgs","repos_url":"https://api.github.com/users/enginsoysal/repos","events_url":"https://api.github.com/users/enginsoysal/events{/privacy}","received_events_url":"https://api.github.com/users/enginsoysal/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":656,"digest":"sha256:d078017738b7d0f511852c07e3a7d936df2e06c4d717d8683603b99f7d4dea2c","download_count":0,"created_at":"2026-11-17T10:27:10Z","updated_at":"2026-11-17T10:27:10Z","browser_download_url":"https://github.com/enginsoysal/engacer-os/releases/download/m1216-v0.12.16/m12stage16-starter-manifest.json"}],"tarball_url":"https://api.github.com/repos/enginsoysal/engacer-os/tarball/m1216-v0.12.16","zipball_url":"https://api.github.com/repos/enginsoysal/engacer-os/zipball/m1216-v0.12.16","body":"# Engacer OS M12.16 / 0.12.16 — Keyboard and accessibility\n\nM12-STAGE16-VM-v1 native qualification passes for these exact bytes. Complete public delivery closes separately before M12.17.\n\nBuild: `931575f2d9d3cbfc2038125c394f7589`.\nISO SHA256: `15b0ab8d350d7c157f150bb21c81dbc01bd12eab3d77fa57ff7d885eae34578a`.\nVMware ZIP SHA256: `9b14bab653ab8478876174349d68626915d0a0c6f7607346d61e48c245a394cf`.\n\n## What changes\n\nSettings adds Accessibility: independent high contrast and reduced effects. Tab/Shift+Tab and Enter/Space expose visible native focus. F6/Shift+F6 moves among available window, taskbar, desktop and notification panes. F1 describes the actual focused control and preserves the underlying dialog or unsaved document. Original USB HID and PS/2 providers handle the same keys.\n\nSupported display previews now use the ordinary desktop logical 800×600 minimum. Physical cursor hotspots reach every screen edge without shifting to fit the whole arrow. Real 150% and 4K/200% tests compare physical VRAM, compositor shadow, input and actual scaled clicks.\n\n## How and why\n\nTwo bounded semantic records and four state words avoid per-control label allocations. The existing appearance ABI stays unchanged; accessibility saves a separately validated 16-byte per-user record. Invalid length/magic/version/flags/reserved data uses safe defaults and is not silently rewritten. Reduced effects removes decorative shadows, hover washes and pressed icon/text movement. No new app slot, background worker, framebuffer cache or idle scanner is introduced. Fixed shell state is 553,452 bytes (+224 from M12.15), including alignment and clipped-cursor fallback state; shared fonts are unchanged.\n\n[Architecture](https://github.com/enginsoysal/engacer-os/blob/87fedd75c46fe4bcc3263a29f39be1491b6e7069/docs/architecture/accessibility-m1216.md), [keyboard guide](https://github.com/enginsoysal/engacer-os/blob/87fedd75c46fe4bcc3263a29f39be1491b6e7069/docs/handbook/accessibility-m1216.md), [installation](https://github.com/enginsoysal/engacer-os/blob/87fedd75c46fe4bcc3263a29f39be1491b6e7069/docs/handbook/install-m1216.md).\n\n## Verification\n\n[Exact-source acceptance](https://github.com/enginsoysal/engacer-os/blob/87fedd75c46fe4bcc3263a29f39be1491b6e7069/evidence/M12/16/acceptance-results.json) binds 599 compiled inputs and 12 native task/profile checks to keyboard-only installation and desktop tasks, independent USB/PS2 startups, five actual Light/Dark/high-contrast scale profiles, held-input pixel comparisons, modal/generation/eight-window ownership, six independently filesystem-CRC-valid malformed record cases, valid reset and no silent writes.\n\nExact enabled-device VMware, separate BIOS startup, twelve cached/full movement comparisons and actual compressed boot repair pass. Production palette tests cover all 16,777,216 accent foregrounds and 1,572,864 component states; decoder/taskbar bounds remain separately checked. [Resources](https://github.com/enginsoysal/engacer-os/blob/87fedd75c46fe4bcc3263a29f39be1491b6e7069/evidence/M12/16/resources.json) separate fixed state, peak and retention. Automated review is not a participant usability study.\n\n## Scope\n\nNative Focus Help is a visual semantic consumer, not an external screen-reader or speech protocol. Native shadow-framebuffer cursor profiles are tested; the guarded direct-framebuffer fallback is compile-qualified separately. Named virtual profiles only: physical/ARM, universal hardware, vendor GPU 3D and expanded Windows support remain unqualified. Advanced partition tools retain logical 1024×768. M12.17 handles rendering performance; M12.18 retains the final controller/original-app matrix and site-sharing observation. Earlier candidate failures remain diagnostics.\n\n![Actual native 4K accessibility](https://raw.githubusercontent.com/enginsoysal/engacer-os/87fedd75c46fe4bcc3263a29f39be1491b6e7069/evidence/M12/16/feature.png)\n"}