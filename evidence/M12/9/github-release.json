enginsoysal/gists{/gist_id}","starred_url":"https://api.github.com/users/enginsoysal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/enginsoysal/subscriptions","organizations_url":"https://api.github.com/users/enginsoysal/orgs","repos_url":"https://api.github.com/users/enginsoysal/repos","events_url":"https://api.github.com/users/enginsoysal/events{/privacy}","received_events_url":"https://api.github.com/users/enginsoysal/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1839,"digest":"sha256:a126a7d82af8c2a0c7687440a1e918450534275dabb13eeb01e47a6beadb2918","download_count":0,"created_at":"2026-11-17T01:48:26Z","updated_at":"2026-11-17T01:48:27Z","browser_download_url":"https://github.com/enginsoysal/engacer-os/releases/download/m129-v0.12.9/M12STAGE9-SHA256SUMS.txt"},{"url":"https://api.github.com/repos/enginsoysal/engacer-os/releases/assets/757197002","id":757197002,"node_id":"RA_kwDOVj6ISs4tIejK","name":"m12stage9-starter-manifest.json","label":"","uploader":{"login":"enginsoysal","id":103884748,"node_id":"U_kgDOBjEnzA","avatar_url":"https://avatars.githubusercontent.com/u/103884748?v=4","gravatar_id":"","url":"https://api.github.com/users/enginsoysal","html_url":"https://github.com/enginsoysal","followers_url":"https://api.github.com/users/enginsoysal/followers","following_url":"https://api.github.com/users/enginsoysal/following{/other_user}","gists_url":"https://api.github.com/users/enginsoysal/gists{/gist_id}","starred_url":"https://api.github.com/users/enginsoysal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/enginsoysal/subscriptions","organizations_url":"https://api.github.com/users/enginsoysal/orgs","repos_url":"https://api.github.com/users/enginsoysal/repos","events_url":"https://api.github.com/users/enginsoysal/events{/privacy}","received_events_url":"https://api.github.com/users/enginsoysal/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":653,"digest":"sha256:93603d8d195e164a0abf1e8c8e3d9b6fc4d8684b0fa295f24fb193453a9687a3","download_count":0,"created_at":"2026-11-17T01:48:27Z","updated_at":"2026-11-17T01:48:27Z","browser_download_url":"https://github.com/enginsoysal/engacer-os/releases/download/m129-v0.12.9/m12stage9-starter-manifest.json"}],"tarball_url":"https://api.github.com/repos/enginsoysal/engacer-os/tarball/m129-v0.12.9","zipball_url":"https://api.github.com/repos/enginsoysal/engacer-os/zipball/m129-v0.12.9","body":"# Engacer OS M12.9 / 0.12.9 - Start and local search\n\nNative qualification passes **M12-STAGE9-VM-v1**. GitHub downloads and complete\npublic website verification close separately before M12.10.\n\nBuild: `9eb7af562b85bcfa14609773dbd1e718`.\nISO SHA256: `b56cefb8eb9d781fa308db1944ae3f60ac760e8d1767e04a93d6249bd888f104`.\nVMware ZIP SHA256: `91992a6f77745dc53da7b65a2a30424c14fe3a3c3079155376bf16c1323db0bb`.\n\n## What changes\n\nStart is more compact and uses the shared original app/folder icons. A heading\nidentifies Pinned, Installed apps, the selected category or local search. The\nvisible result range and total explain when another page is available. Grid\nsubtitles identify app categories without redundant pin text; full-width\nresults retain pin status. Search always uses a full-width list.\n\nLocal search puts exact labels before prefixes and other partial matches,\nwith alphabetical ordering within equal ranks. It searches installed apps and\npinned folder/app labels on this device. It does not search the Internet or\nindex the filesystem. A search keystroke does not launch an app process.\n\nExisting categories, visibility, ordering, renamed pins and taskbar references\nkeep their validated version-one preference format. Unpinning changes a\nreference rather than removing an app or folder. Optional app removal prunes\nits references; reinstall restores its catalogue availability. Native folder\npins open their actual paths. Keyboard arrows use the same columns as drawing;\nTab, Enter, Shift+F10 and Escape retain their supported routes.\n\n## How and why\n\nKeep the existing bounded catalogue and preferences instead of adding a second\nlauncher database, indexing service, worker or raster cache. At most 52 result\nreferences are sorted on demand. Exact/prefix/substring ranking uses the same\nvalidated bounded ASCII labels and query. Panel/control geometry and shared\nfont/icons are reused. The native visual review widened New category and added\npagination feedback before qualification; its earlier prototype and controlled\ntest stop remain honest diagnostics, not qualification of the final bytes.\n\n[Design decisions](https://github.com/enginsoysal/engacer-os/blob/f2ae6b1366440174517eee16212bec7ffc20e81c/docs/architecture/start-m129.md), [Start instructions](https://github.com/enginsoysal/engacer-os/blob/f2ae6b1366440174517eee16212bec7ffc20e81c/docs/handbook/start-m129.md)\nand [eight-step installation](https://github.com/enginsoysal/engacer-os/blob/f2ae6b1366440174517eee16212bec7ffc20e81c/docs/handbook/install-m129.md).\n\n## Verification\n\n[Exact-source acceptance](https://github.com/enginsoysal/engacer-os/blob/f2ae6b1366440174517eee16212bec7ffc20e81c/evidence/M12/9/acceptance-results.json) records\n588 compiled Git inputs, native search/launch/category/pin/remove/reinstall/\nfolder journeys and two ordinary no-ISO starts with independently read exact\npreferences. Compact light/dark, actual 150% and physical 3840x2160/200% exercise\nStart, local results, context menus, Tab and category review. The exact VMware\nstarter and separate BIOS paths install and start independently. Twelve cached\nversus full movement comparisons and actual compressed boot repair are separate\nchecks. Host production ranking covers sixteen cases; the actual page decoder\ncovers 552 pages and 10808 malformed/fuzz cases with unchanged canaries.\n\n[Resources](https://github.com/enginsoysal/engacer-os/blob/f2ae6b1366440174517eee16212bec7ffc20e81c/evidence/M12/9/resources.json) separate fixed state, peak and\nretained managed pages. Fixed shell state remains 552085 bytes, unchanged from\nM12.8; shared font bytes are unchanged. Tasks return their managed pages\nand CPUs halt at idle. Configured guest RAM is not measured OS consumption.\n\n## Scope and retained limits\n\n- Search covers installed catalogue/pinned labels, not all files or online services.\n- This stage retains the native app, file-provider and format limits. It does not\n  expand Windows compatibility or qualify Steam/vendor GPU 3D.\n- Taskbar redesign follows separately in M12.10; later stages close in order.\n- Clear the query before changing browse view/category. Search stays global and\n  full-width; clarifying those affordances is retained for M12.14 feedback.\n- Finish/cancel transfers before opening a picker. Menu/conflict feedback and\n  background transfer/modal arbitration remain M12.14 integration work.\n- Small startup/explicit scaling reconciliation and cursor isolation remain M12.16.\n- The earlier concurrent BIOS/AHCI observation and complete final controller/\n  original-app matrix remain M12.18. Stress reliability is not established here.\n- Physical/ARM and universal hardware/Windows support remain unqualified.\n- Agent visual/scenario review is not a human usability study. GitHub downloads\n  and complete website proof close separately before the next stage.\n\n![Actual native Start menu](https://raw.githubusercontent.com/enginsoysal/engacer-os/f2ae6b1366440174517eee16212bec7ffc20e81c/evidence/M12/9/feature.png)\n"}